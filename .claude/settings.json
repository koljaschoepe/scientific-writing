{
  "//": "Rechte für Nicht-Techniker: praktisch nie eine Nachfrage, nur ein kleines Netz gegen Unumkehrbares. Eigene Ausnahmen gehören in .claude/settings.local.json.",
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Bash",
      "PowerShell",
      "Read",
      "Edit",
      "Write",
      "WebFetch",
      "WebSearch",
      "mcp__playwright"
    ],
    "//deny": "Alles hier zerstört Arbeit, die ohne Technikwissen nicht zurückzuholen ist.",
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push * --force *)",
      "Bash(git push * -f *)",
      "Bash(git reset --hard *)",
      "Bash(git clean *)",
      "Bash(git filter-branch *)",
      "Bash(rm -rf / *)",
      "Bash(rm -rf ~ *)",
      "Bash(rm -rf ~/ *)",
      "Bash(gh repo delete *)",
      "PowerShell(git push --force *)",
      "PowerShell(git push -f *)",
      "PowerShell(git reset --hard *)",
      "PowerShell(git clean *)",
      "PowerShell(Remove-Item * C:\\ *)",
      "PowerShell(Format-Volume *)",
      "PowerShell(gh repo delete *)",
      "mcp__playwright__browser_run_code_unsafe"
    ]
  },
  "//hooks": "Node statt bash/python: läuft identisch auf Windows und macOS. Exec-Form, damit Leerzeichen im Pfad nichts kaputt machen.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/start.mjs"],
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/stop.mjs"],
            "timeout": 15
          }
        ]
      }
    ]
  },
  "enabledMcpjsonServers": ["playwright"]
}
