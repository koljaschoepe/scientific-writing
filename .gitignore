# Scientific Writing Kit
# Herstellerzone: /update ergänzt hier fehlende Zeilen, eigene Einträge bleiben erhalten.

# Generiert, wird bei jedem Lauf neu erzeugt
dashboard.html
latex/build/
latex/kapitel/

# Betriebssystem
.DS_Store
Thumbs.db
desktop.ini
*~

# Code-Teil (uv legt die Umgebung selbst neu an)
code/.venv/
.venv/
__pycache__/
*.pyc
.ipynb_checkpoints/
node_modules/

# Protokolle der Installation
install/*.log

# Persönliche Claude-Einstellungen dieses Rechners
.claude/settings.local.json

# Temporäre Dateien
*.tmp
*.bak
.~lock.*

# Bewusst NICHT ignoriert: quellen/pdfs/
# Das Arbeits-Repo ist privat, die PDFs sind Teil deiner Arbeit und sollen mit /sync
# gesichert werden. Einzelne Dateien über 95 MB meldet /sync (GitHub-Grenze 100 MB).
# Wer das Kit öffentlich teilt, trägt hier "quellen/pdfs/*.pdf" ein (Urheberrecht).
latex/build-expose/
Arbeit-neu.pdf
*.aux
*.bcf
*.run.xml
